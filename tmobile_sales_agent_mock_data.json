  "demo_scenarios": [
    {
      "id": "scenario_budget",
      "transcript": "My bill is too expensive. I want to spend no more than $50 a month, and I mostly use my phone for everyday things.",
      "expected_behavior": "Prioritize lower-cost plans and devices; ask whether the $50 budget includes a new phone if unclear."
    },
    {
      "id": "scenario_keep_phone",
      "transcript": "I like my current iPhone and don't want to upgrade. Can I lower my monthly bill?",
      "expected_behavior": "Recommend plan options only; do not push a new phone."
    },
    {
      "id": "scenario_camera",
      "transcript": "I take lots of photos and want a better camera, but I don't want the most expensive phone.",
      "expected_behavior": "Compare mainstream camera-capable phones and explain the cost tradeoff."
    },
    {
      "id": "scenario_family",
      "transcript": "There are three people in my family. We're all paying separate bills and want to save money.",
      "expected_behavior": "Consider the multi-line mock plan and compare total household cost, clearly labeling all prices as fictional."
    },
    {
      "id": "scenario_foldable",
      "transcript": "I want an Android phone that folds and fits in my pocket. My budget is around $80 a month.",
      "expected_behavior": "Prioritize foldable preference, then verify combined device and plan cost against budget."
    },
    {
      "id": "scenario_no_match",
      "transcript": "I need a new phone and plan for a total of $20 a month, including the device.",
      "expected_behavior": "Return no suitable match if no option satisfies the budget; explain the constraint and ask whether the budget can change."
    }
  ]
